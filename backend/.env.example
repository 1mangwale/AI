# =============================================
# Mangwale AI — Environment Configuration
# =============================================
# Copy this file to .env and fill in real values.
# Lines marked [MUST CHANGE] must be set for production.
# Lines marked [OPTIONAL] have sensible defaults.

# === Core ===
NODE_ENV=development
PORT=3200
APP_NAME=Mangwale AI
LOG_LEVEL=debug
TZ=Asia/Kolkata

# === PostgreSQL [MUST CHANGE in production] ===
DATABASE_URL=postgresql://mangwale_config:CHANGE_ME@localhost:5432/headless_mangwale
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mangwale_config
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=headless_mangwale

# === Redis [OPTIONAL — defaults work for dev] ===
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=1

# === JWT [MUST CHANGE] ===
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# === Cookie Domain [MUST CHANGE for production] ===
COOKIE_DOMAIN=.mangwale.ai

# === WhatsApp Cloud API [MUST CHANGE] ===
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# === Razorpay [MUST CHANGE] ===
RAZORPAY_WEBHOOK_SECRET=

# === PHP Backend ===
PHP_BACKEND_URL=https://new.mangwale.com
PHP_API_BASE_URL=https://new.mangwale.com

# === PHP MySQL (readonly) ===
MYSQL_HOST=103.160.107.208
MYSQL_PORT=3307
MYSQL_DATABASE=mangwale_db
MYSQL_USER=
MYSQL_PASSWORD=

# === NLU / Mercury GPU ===
NLU_PRIMARY_ENDPOINT=http://192.168.0.151:7012
NLU_CONFIDENCE_THRESHOLD=0.65

# === Search ===
SEARCH_API_URL=http://localhost:3100

# === LLM ===
LLM_MODE=hybrid
VLLM_URL=http://localhost:8002
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
DEFAULT_LLM_PROVIDER=vllm
DEFAULT_CLOUD_PROVIDER=groq

# === Cloud LLM API Keys [OPTIONAL] ===
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === CORS (comma-separated additional origins) ===
ADDITIONAL_CORS_ORIGINS=
