# =============================================
# Mangwale AI — Environment Configuration
# =============================================
# Copy this file to .env and fill in real values.
# Lines marked [MUST CHANGE] must be set for production.
# Lines marked [OPTIONAL] have sensible defaults.

# === Core ===
NODE_ENV=development
PORT=3200
APP_NAME=Mangwale AI
LOG_LEVEL=debug
TZ=Asia/Kolkata

# === PostgreSQL [MUST CHANGE in production] ===
DATABASE_URL=postgresql://mangwale_config:CHANGE_ME@localhost:5432/headless_mangwale
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mangwale_config
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=headless_mangwale
# Keep false/blank in production. Support ticket schema changes require the
# approved Prisma migration, not boot-time CREATE/ALTER statements.
SUPPORT_TICKET_AUTO_SCHEMA_SYNC=false
# Keep false/blank in production. Approval schema changes require an approved
# migration or explicitly approved local bootstrap.
APPROVAL_AUTO_SCHEMA_SYNC=false

# === Redis [OPTIONAL — defaults work for dev] ===
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=1

# === JWT [MUST CHANGE] ===
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# === Cookie Domain [MUST CHANGE for production] ===
COOKIE_DOMAIN=.mangwale.ai

# === WhatsApp Cloud API [MUST CHANGE] ===
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# === WhatsApp Native Calling Pilot [fail closed by default] ===
# V1 scope: user-initiated inbound support calls, human/manual first.
# Keep disabled until Meta approval, webhook smoke, and Akash approval are captured.
WHATSAPP_CALLING_ENABLED=false
WHATSAPP_CALLING_META_APPROVED=false
WHATSAPP_CALLING_INBOUND_SUPPORT_ENABLED=false
WHATSAPP_CALLING_SIGNALING_MODE=graph_api
WHATSAPP_CALLING_WEBHOOK_URL=https://api.mangwale.ai/api/webhook/whatsapp
WHATSAPP_REPLY_ALLOWLIST_REQUIRED=true
WHATSAPP_REPLY_ALLOWED_SENDER_HASHES=
WHATSAPP_OUTBOUND_ALLOWLIST_REQUIRED=true
WHATSAPP_OUTBOUND_ALLOWED_RECIPIENT_HASHES=
WHATSAPP_CALLING_GRAPH_APP_WEBHOOK_SUBSCRIBED=false
WHATSAPP_CALLING_EVENT_ROUTING_APPROVED_EXECUTOR_ONLY=true
WHATSAPP_CALLING_BUSINESS_HOURS=09:00-21:00
WHATSAPP_CALLING_BUSINESS_HOURS_TIMEZONE=Asia/Kolkata
# Required only for business-initiated/outbound callback readiness, not inbound support intake.
WHATSAPP_CALLING_PERMISSION_TEMPLATE_NAME=
WHATSAPP_CALLING_PERMISSION_HASH_STORAGE_ENABLED=true
WHATSAPP_CALLING_OPTOUT_ENABLED=true
WHATSAPP_CALLING_SCHEMA_VERIFIED=false
WHATSAPP_CALLING_AUDIT_STORAGE_ENABLED=false
WHATSAPP_CALLING_TEMPLATE_APPROVED=false
WHATSAPP_CALLING_LIVE_EXECUTOR_ENABLED=false
WHATSAPP_CALLING_PROVIDER_ADAPTER_ENABLED=false
WHATSAPP_CALLING_INTERNAL_TEST_ALLOWLIST_HASHES=

# === Meta / Instagram [OPTIONAL until connected] ===
# Default flow is Facebook Login for Business: IG professional account linked to a Facebook Page.
# Use INSTAGRAM_LOGIN_MODE=instagram only if using the newer Instagram Login flow.
META_GRAPH_API_VERSION=v24.0
INSTAGRAM_LOGIN_MODE=facebook
INSTAGRAM_GRAPH_BASE_URL=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
META_APP_SECRET=
META_AD_ACCOUNT_ID=

# === Telegram / SMS webhook auth [MUST CHANGE when enabled] ===
TELEGRAM_WEBHOOK_SECRET_TOKEN=
MSG91_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_WEBHOOK_URL=

# === Razorpay [MUST CHANGE] ===
RAZORPAY_WEBHOOK_SECRET=

# === PHP Backend ===
PHP_BACKEND_URL=https://dashboard.mangwale.in
PHP_API_BASE_URL=https://dashboard.mangwale.in
MANGWALE_ENV_TARGET=dev
MANGWALE_ACTION_MODE=dry_run
MANGWALE_EXTERNAL_SENDS=off

# === PHP MySQL (readonly) ===
MYSQL_HOST=103.160.107.208
MYSQL_PORT=3307
MYSQL_DATABASE=mangwale_db
MYSQL_USER=
MYSQL_PASSWORD=

# === NLU / Mercury GPU ===
NLU_PRIMARY_ENDPOINT=http://100.117.131.56:7012
NER_SERVICE_URL=http://100.117.131.56:7011
ASR_SERVICE_URL=http://100.117.131.56:7001
TTS_SERVICE_URL=http://100.117.131.56:7002
VOICE_ORCHESTRATOR_URL=http://100.117.131.56:7000
NERVE_SYSTEM_URL=http://100.117.131.56:7100
NLU_CONFIDENCE_THRESHOLD=0.65

# === Search ===
SEARCH_API_BASE_URL=https://opensearch.mangwale.com
SEARCH_API_URL=https://opensearch.mangwale.com

# === LLM ===
LLM_MODE=hybrid
VLLM_URL=http://localhost:8002
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
DEFAULT_LLM_PROVIDER=vllm
DEFAULT_CLOUD_PROVIDER=groq

# === Cloud LLM API Keys [OPTIONAL] ===
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === CORS (comma-separated additional origins) ===
ADDITIONAL_CORS_ORIGINS=
